#!/bin/bash
# Builds the Web/WASM module from the shared EarthDSPCore.
#
# The old implementation lived in the root Dattorro/ and Util/ trees. It is now
# built from shared/ so Web and JUCE run the same DSP core.
set -e

emcc -O3 \
    --bind \
    -s WASM=1 \
    -s ALLOW_MEMORY_GROWTH=1 \
    -s EXPORT_ES6=1 \
    -s MODULARIZE=1 \
    -s EXPORT_NAME="'EarthModule'" \
    -s EXPORTED_FUNCTIONS="['_malloc', '_free']" \
    -std=c++20 \
    -I./shared \
    src/wasm_wrapper.cpp \
    shared/EarthDSPCore.cpp \
    shared/Dattorro/Dattorro.cpp \
    shared/Dattorro/dsp/delays/InterpDelay.cpp \
    shared/Dattorro/dsp/filters/OnePoleFilters.cpp \
    shared/Effects/Overdrive.cpp \
    -o web/earth-module.js
